table MeasuresTable
	lineageTag: 3e96e1bf-9b16-4a62-900a-b3e5da477906

	measure 'Avg Sleep Hours' = AVERAGE('Platform Details'[Sleep_Hours_Per_Night])
		lineageTag: 19725d56-7e66-46de-aa3c-42b1ed8c2c5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Usage Hours' = AVERAGE('Platform Details'[Avg_Daily_Usage_Hours])
		lineageTag: 6fb7c232-fccc-4064-8a23-6a31a2bd7f1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Affected Academically' = DIVIDE(CALCULATE(COUNTROWS('Platform Details'),'Platform Details'[Affects_Academic_Performance] = "Yes"),COUNTROWS('Platform Details'))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b73c4e68-ec34-45c9-af7d-b8794601bc8e

	measure 'Addicted Student Count' = CALCULATE(COUNTROWS('Platform Details'),'Platform Details'[Addicted_Score]>7)
		formatString: 0
		lineageTag: 4968d5fa-10a4-42e3-8cee-9589fea9a527

	partition MeasuresTable = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

