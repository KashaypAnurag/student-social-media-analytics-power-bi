model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Platform Details","Student Details","MeasuresTable"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Platform Details'
ref table 'Student Details'
ref table DateTable
ref table MeasuresTable

ref cultureInfo en-US

